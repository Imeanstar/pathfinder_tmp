# 이 파일을 .env로 복사한 뒤 실제 키를 채우세요: cp .env.example .env
# .env는 .gitignore에 등록되어 있어 git에는 절대 올라가지 않습니다 — 각자 로컬에서 채워야 합니다.

# Google AI Studio에서 발급 (무료): https://aistudio.google.com/apikey
# 없으면 서버가 자동으로 "개발 모드"로 동작합니다 — PII 마스킹까지는 되지만
# 성적표에서 과목을 인식하는 기능만 빈 배열을 반환합니다(거짓 데이터를 지어내지 않기 위한 설계).
GOOGLE_API_KEY=

# 구글 로그인(@ajou.ac.kr 계정만 허용)용 OAuth 2.0 클라이언트 ID — Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) > 사용자 인증 정보 만들기 >
# OAuth 클라이언트 ID > 애플리케이션 유형 "웹 애플리케이션"에서 발급받으세요.
# "승인된 자바스크립트 원본"에 서버 주소(로컬은 http://localhost:8000)를 등록해야 합니다.
# 리디렉션 URI는 필요 없습니다(Google Identity Services 토큰 방식이라 팝업으로 끝남).
# 없으면 로그인 버튼을 눌러도 "아직 설정되지 않았습니다" 안내만 뜨고, 나머지 기능은
# 그대로 동작합니다.
GOOGLE_OAUTH_CLIENT_ID=

# 로그인 계정의 이메일을 해시(HMAC-SHA256)해 저장할 때 쓰는 서버 전용 비밀값 — 이게 없으면
# 개발용 기본값(안전하지 않음, app/auth.py의 _DEV_DEFAULT_PEPPER)으로 동작합니다.
# 배포 전에는 반드시 무작위 값으로 채우세요: python3 -c "import secrets; print(secrets.token_hex(32))"
# pepper가 없으면 "학번@ajou.ac.kr" 같은 예측 가능한 이메일 패턴을 사전 대입해 DB 유출 시
# 원래 이메일을 역산당할 수 있습니다 — pepper가 있어야 진짜 익명화입니다.
EMAIL_HASH_PEPPER=
